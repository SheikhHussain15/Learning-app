{
  "openapi": "3.0.3",
  "info": {
    "title": "Quiz API",
    "version": "1.0.0",
    "description": "API for Quiz Experience endpoints"
  },
  "paths": {
    "/quiz/{quizId}": {
      "get": {
        "summary": "Get quiz details",
        "parameters": [
          {
            "name": "quizId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Quiz details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quiz"
                }
              }
            }
          }
        }
      }
    },
    "/quiz/{quizId}/start": {
      "post": {
        "summary": "Start a quiz attempt",
        "parameters": [
          {
            "name": "quizId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Quiz attempt created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuizAttempt"
                }
              }
            }
          }
        }
      }
    },
    "/quiz/attempts/{attemptId}": {
      "get": {
        "summary": "Get quiz attempt details",
        "parameters": [
          {
            "name": "attemptId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Quiz attempt details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuizAttempt"
                }
              }
            }
          }
        }
      }
    },
    "/quiz/attempts/{attemptId}/answer": {
      "post": {
        "summary": "Submit answer for question",
        "parameters": [
          {
            "name": "attemptId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerSubmission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer feedback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerFeedback"
                }
              }
            }
          }
        }
      }
    },
    "/quiz/attempts/{attemptId}/complete": {
      "post": {
        "summary": "Complete quiz attempt",
        "parameters": [
          {
            "name": "attemptId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Quiz results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuizResults"
                }
              }
            }
          }
        }
      }
    },
    "/quiz/attempts/{attemptId}/review": {
      "get": {
        "summary": "Get quiz review with correct answers",
        "parameters": [
          {
            "name": "attemptId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Quiz review",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuizReview"
                }
              }
            }
          }
        }
      }
    },
    "/quiz/{quizId}/retry": {
      "post": {
        "summary": "Start a new quiz attempt (retry)",
        "parameters": [
          {
            "name": "quizId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "New quiz attempt created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuizAttempt"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Quiz": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Question"
            }
          },
          "total_questions": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Question": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionOption"
            }
          },
          "order": {
            "type": "integer"
          }
        }
      },
      "QuestionOption": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          }
        }
      },
      "QuizAttempt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "quiz_id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": ["in_progress", "completed", "abandoned"]
          },
          "current_question_index": {
            "type": "integer"
          },
          "total_questions": {
            "type": "integer"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AnswerSubmission": {
        "type": "object",
        "required": ["question_id", "option_id"],
        "properties": {
          "question_id": {
            "type": "string",
            "format": "uuid"
          },
          "option_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AnswerFeedback": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "format": "uuid"
          },
          "selected_option_id": {
            "type": "string",
            "format": "uuid"
          },
          "correct_option_id": {
            "type": "string",
            "format": "uuid"
          },
          "is_correct": {
            "type": "boolean"
          },
          "explanation": {
            "type": "string"
          }
        }
      },
      "QuizResults": {
        "type": "object",
        "properties": {
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "total_questions": {
            "type": "integer"
          },
          "correct_answers": {
            "type": "integer"
          },
          "time_spent": {
            "type": "integer",
            "description": "Time spent in seconds"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "QuizReview": {
        "type": "object",
        "properties": {
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReviewQuestion"
            }
          },
          "score": {
            "type": "number"
          },
          "total_questions": {
            "type": "integer"
          }
        }
      },
      "ReviewQuestion": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionOption"
            }
          },
          "selected_option_id": {
            "type": "string",
            "format": "uuid"
          },
          "correct_option_id": {
            "type": "string",
            "format": "uuid"
          },
          "is_correct": {
            "type": "boolean"
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    }
  }
}