{
  "openapi": "3.0.3",
  "info": {
    "title": "AI Tutor API",
    "version": "1.0.0",
    "description": "API for AI Tutor Conversation endpoints"
  },
  "paths": {
    "/tutor/{documentId}/conversations": {
      "get": {
        "summary": "Get conversations for document",
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of conversations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TutorConversation"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tutor/{documentId}/conversations": {
      "post": {
        "summary": "Create new conversation",
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Conversation created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TutorConversation"
                }
              }
            }
          }
        }
      }
    },
    "/tutor/conversations/{conversationId}": {
      "get": {
        "summary": "Get conversation details",
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TutorConversation"
                }
              }
            }
          }
        }
      }
    },
    "/tutor/conversations/{conversationId}/messages": {
      "post": {
        "summary": "Send message to tutor",
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TutorMessage"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tutor response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TutorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/tutor/conversations/{conversationId}/messages/stream": {
      "post": {
        "summary": "Send message with streaming response",
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TutorMessage"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Streaming tutor response",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/tutor/conversations/{conversationId}/history": {
      "get": {
        "summary": "Get conversation history",
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation history",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TutorMessageRecord"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TutorConversation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "description": "Auto-generated from first message"
          },
          "message_count": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TutorMessage": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "content": {
            "type": "string",
            "description": "User's question or message"
          }
        }
      },
      "TutorResponse": {
        "type": "object",
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": ["assistant"]
          },
          "content": {
            "type": "string",
            "description": "Tutor's response"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceReference"
            },
            "description": "Source citations for the response"
          },
          "is_grounded": {
            "type": "boolean",
            "description": "Whether response is grounded in document content"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence score for the response"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TutorMessageRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": ["user", "assistant"]
          },
          "content": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceReference"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SourceReference": {
        "type": "object",
        "properties": {
          "chunk_id": {
            "type": "string",
            "format": "uuid"
          },
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "chapter_title": {
            "type": "string"
          },
          "topic_title": {
            "type": "string"
          },
          "content_preview": {
            "type": "string",
            "description": "Preview of the source chunk"
          },
          "relevance_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}