{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuizOutput",
  "description": "Output schema for Quiz agent",
  "type": "object",
  "required": ["questions", "metadata"],
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "options", "correct_index", "explanation", "difficulty", "source_chunk_ids"],
        "properties": {
          "question": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" }, "minItems": 4, "maxItems": 4 },
          "correct_index": { "type": "integer", "minimum": 0, "maximum": 3 },
          "explanation": { "type": "string" },
          "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
          "source_chunk_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["total_questions", "difficulty_distribution", "coverage_nodes"],
      "properties": {
        "total_questions": { "type": "integer" },
        "difficulty_distribution": {
          "type": "object",
          "properties": {
            "easy": { "type": "integer" },
            "medium": { "type": "integer" },
            "hard": { "type": "integer" }
          }
        },
        "coverage_nodes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
