{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RecommendationOutput",
  "description": "Output schema for Recommendation agent",
  "type": "object",
  "required": ["recommendations", "weak_areas"],
  "properties": {
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recommendation_type", "title", "reason", "confidence", "source_doc_ids"],
        "properties": {
          "recommendation_type": { "type": "string", "enum": ["study", "review", "quiz", "explore"] },
          "title": { "type": "string" },
          "reason": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source_doc_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "weak_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "score", "suggested_action"],
        "properties": {
          "topic": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "suggested_action": { "type": "string" }
        }
      }
    }
  }
}
